{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Фото до 15 МБ + запас на поля формы.
	request_body {
		max_size 20MB
	}

	reverse_proxy app:8080 {
		# SSE: отдавать события сразу, без буферизации.
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
