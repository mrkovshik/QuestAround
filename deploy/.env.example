# Скопируйте в .env и заполните:  cp .env.example .env && nano .env

# Домен, на который смотрит A-запись DNS (без https://)
DOMAIN=example.ru

# Почта для Let's Encrypt (уведомления о сертификате)
ACME_EMAIL=you@example.com

# Сгенерируйте: openssl rand -hex 24
POSTGRES_PASSWORD=

# Токен входа в /admin. Сгенерируйте: openssl rand -hex 24
ADMIN_TOKEN=
